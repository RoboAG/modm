class TimerInstance(Module):
	def __init__(self, instance, type):
		self.instance = instance
		self.type = type

	def init(self, module):
		module.name = str(self.instance)

	def prepare(self, module, options):
		return True

	def build(self, env):
		env.outbasepath = "modm/src/modm/platform/timer"

		env.substitutions = {
			"id" : self.instance,
			"type" : self.type,
			"output_channels" : [
				{ "id" : "A", "output_mode_shift" : 6 },
				{ "id" : "B", "output_mode_shift" : 4 }
			]
		}
		env.template("timer_instance.hpp.in", "timer_{}.hpp".format(self.instance))

def init(module):
	module.name = ":platform:timer"
	module.description = "AVR Basic Timer/Counters"

def prepare(module, options):
	device = options[":target"]
	# limit usage to ATmega328P for now
	if not device.identifier.string.startswith("atmega328p"):
		return False

	module.depends(
		":stdc++",
		":math:units",
		":architecture:register",
		":platform:gpio",
		":platform:clock")

	timers8bit = device.get_driver("tc:tc8")["instance"]
	for instance in timers8bit:
		module.add_submodule(TimerInstance(instance, "Timer8Bit"))

	timers8bitasync = device.get_driver("tc:tc8_async")["instance"]
	for instance in timers8bitasync:
		module.add_submodule(TimerInstance(instance, "Timer8BitAsync"))

	timers16bit = device.get_driver("tc:tc16")["instance"]
	for instance in timers16bit:
		module.add_submodule(TimerInstance(instance, "Timer16Bit"))

	return True

def build(env):
	env.outbasepath = "modm/src/modm/platform/timer"

	env.copy("chrono_utils.hpp")
	env.copy("timer_base.hpp")
	env.copy("timer_8bit.hpp")
	env.copy("timer_8bit_impl.hpp")
	env.copy("timer_8bit_async.hpp")
	env.copy("timer_8bit_async_impl.hpp")
	env.copy("timer_16bit.hpp")
	env.copy("timer_16bit_impl.hpp")
	env.copy("pwm.hpp")
	env.copy("pwm_impl.hpp")
