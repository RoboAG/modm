#ifndef MODM_AVR_TIMER_{{ id }}_HPP
#define MODM_AVR_TIMER_{{ id }}_HPP

#include "timer_8bit.hpp"

#include <avr/io.h>
#include <type_traits>
#include <chrono>

#include <modm/math/units.hpp>
#include <modm/platform/gpio/base.hpp>
#include <modm/platform/gpio/connector.hpp>
#include <modm/platform/clock/clock.hpp>

namespace modm::platform
{

class Timer{{ id }} : public Timer8Bit
{
public:
	static inline void
	initialize(WaveformGenerationMode wgm, ClockSource cs)
	{
		TccrA_t tccrA{TCCR{{ id }}A};
		// BUG need to mask off WGM Bit 2
		WgmA_t::set(tccrA, wgm);
		TCCR{{ id }}A = tccrA.value;

		TccrB_t tccrB = (WgmB_t(wgm) & WgmB_t::mask()) | ClockSelect_t(cs);
		TCCR{{ id }}B = tccrB.value;
	}

	static inline void
	setClockSource(ClockSource cs)
	{
		TccrB_t tccrB{TCCR{{ id }}B};
		ClockSelect_t::set(tccrB, cs);
		TCCR{{ id }}B = tccrB.value;
	}

	static inline void
	stop()
	{
		setClockSource(ClockSource::Stopped);
	}

	{% for channel in output_channels %}
	class OutputChannel{{ channel.id|upper }}
	{
		static inline void
		setOutputMode(OutputMode mode)
		{
			using OutputMode{{ channel.id|upper }}_t = Configuration<TccrA_t, OutputMode, 0b11, {{ channel.output_mode_shift }}>;

			TccrA_t tccrA{TCCR{{ id }}A};
			OutputMode{{ channel.id|upper }}_t::set(tccrA, mode);
			TCCR{{ id }}A = tccrA.value;
		}

	public:
		template<class Signal>
		static void
		connect(OutputMode mode)
		{
			static_assert(Signal::Signal == Gpio::Signal::Oc{{ channel.id|lower }});
			using Connector = GpioConnector<Peripheral::Tc{{ id }}, Signal>;
			Connector::connect();

			setOutputMode(mode);
		}

		template<class Signal>
		static void
		disconnect()
		{
			static_assert(Signal::Signal == Gpio::Signal::Oc{{ channel.id|lower }});
			using Connector = GpioConnector<Peripheral::Tc{{ id }}, Signal>;
			Connector::disconnect();

			setOutputMode(OutputMode::Disconnected);
		}

		static inline void
		setCompareRegister(CountType compareValue)
		{
			OCR{{ id }}{{ channel.id|upper }} = compareValue;
		}
	};
	{% endfor %}

	template<PwmMode pwmMode, ClockSource prescaler, CountType topValue>
	class FixedTopPwm
	{
		static constexpr WaveformGenerationMode wgMode = []{
			if constexpr (pwmMode == PwmMode::FastPwm) {
				return topValue == 0xff ? WaveformGenerationMode::FastPwm8Bit : WaveformGenerationMode::FastPwmOcra;
			} else if constexpr (pwmMode == PwmMode::PhaseCorrectPwm) {
				return topValue == 0xff ? WaveformGenerationMode::PhaseCorrectPwm8Bit : WaveformGenerationMode::PhaseCorrectPwmOcra;
			} else {
				static_assert(false, "unsupported PwmMode");
			}
		}();

		static constexpr bool ocraAsTop = wgMode == WaveformGenerationMode::FastPwmOcra || wgMode == WaveformGenerationMode::PhaseCorrectPwmOcra;

	public:
		static void
		initialize()
		{
			Timer{{ id }}::initialize(wgMode, prescaler);

			if constexpr (ocraAsTop) {
				OCR{{ id }}A = topValue;
			}
		}

	private:
		template<class OutputChannel>
		class Channel : private OutputChannel
		{
			static_assert(!(std::is_same_v<OutputChannel, OutputChannelA> && ocraAsTop), "OCRA already used to define TOP");
		public:
			template<class Signal>
			static void
			connect(bool invert = false)
			{
				OutputChannel::template connect<Signal>(invert ? OutputMode::PwmInverted : OutputMode::PwmNormal);
			}

			using OutputChannel::disconnect;

			static void
			setDutyCycle(percent_t dutyCycle)
			{
				OutputChannel::setCompareRegister(static_cast<CountType>(dutyCycle * static_cast<float>(topValue)));
			}

			static void
			setDutyCycle(uint8_t dutyCycleFraction)
			{
				uint8_t compareValue = uint8_t(((uint16_t(topValue) + 1) * uint16_t(dutyCycleFraction)) >> 8);
				OutputChannel::setCompareRegister(compareValue);
			}
		};

	public:
		{% for channel in output_channels %}
		using Channel{{ channel.id|upper }} = Channel<OutputChannel{{ channel.id|upper }}>;
		{% endfor %}
	};

	template<PwmMode pwmMode, CtpDurationWrapper period>
	using FixedPeriodPwm = FixedPeriodPwmHelper<Timer{{ id }}, pwmMode, period>::Impl;

	template<PwmMode pwmMode, frequency_t frequency>
	using FixedFrequencyPwm = FixedPeriodPwm<pwmMode, ClockCycles<SystemClock::Timer>{std::chrono::seconds{1}} / frequency>;

	template<PwmMode pwmMode>
	class VariableFrequencyPwm
	{
		static constexpr WaveformGenerationMode wgMode = []{
			if constexpr (pwmMode == PwmMode::FastPwm) {
				return WaveformGenerationMode::FastPwmOcra;
			} else if constexpr (pwmMode == PwmMode::PhaseCorrectPwm) {
				return WaveformGenerationMode::PhaseCorrectPwmOcra;
			} else {
				static_assert(false, "unsupported PwmMode");
			}
		}();

		template<class OutputChannel>
		class Channel : private OutputChannel
		{
			static_assert(!(std::is_same_v<OutputChannel, OutputChannelA>), "OCRA already used to define TOP");

			inline static uint8_t dutyCycleFraction = 0;

			static void
			updateTopValue(uint8_t newTop)
			{
				uint8_t compareValue = uint8_t(((uint16_t(newTop) + 1) * uint16_t(dutyCycleFraction)) >> 8);
				OutputChannel::setCompareRegister(compareValue);
			}

			friend VariableFrequencyPwm;

		public:
			template<class Signal>
			static void
			connect(bool invert = false)
			{
				OutputChannel::template connect<Signal>(invert ? OutputMode::PwmInverted : OutputMode::PwmNormal);
			}

			using OutputChannel::disconnect;

			static void
			setDutyCycle(percent_t dutyCycle)
			{
				setDutyCycle(uint8_t(dutyCycle * 255.f));
			}

			static void
			setDutyCycle(uint8_t dutyCycleFraction)
			{
				Channel::dutyCycleFraction = dutyCycleFraction;
				uint8_t compareValue = uint8_t(((uint16_t(OCR{{ id }}A) + 1) * uint16_t(dutyCycleFraction)) >> 8);
				OutputChannel::setCompareRegister(compareValue);
			}
		};

	public:
		{% for channel in output_channels if not channel.id|upper == 'A' %}
		using Channel{{ channel.id|upper }} = Channel<OutputChannel{{ channel.id|upper }}>;
		{% endfor %}

		static void
		initialize()
		{
			Timer{{ id }}::initialize(wgMode, ClockSource::Stopped);
		}

		static void
		setPeriod(ClockCycles<SystemClock::Timer> period)
		{
			ClockSource prescaler = selectPrescalerForMaxResolution<isDualSlope(pwmMode)>(period);
			CountType topValue = computeTopValue<isDualSlope(pwmMode)>(prescaler, period);

			setClockSource(prescaler);
			OCR{{ id }}A = topValue;

			{% for channel in output_channels if not channel.id|upper == 'A' %}
			Channel{{ channel.id|upper }}::updateTopValue(topValue);
			{% endfor %}
		}
	};
};

}  // namespace modm::platform

#endif  // MODM_AVR_TIMER_{{ id }}_HPP
